{
  "name": "cv-template-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "security:lint": "node scripts/security-lint.mjs",
    "build": "vite build",
    "verify:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=desktop-chromium --project=tablet-chromium --project=mobile-chromium",
    "lighthouse:assert": "node scripts/assert-lighthouse.mjs",
    "verify": "npm run security:lint && npm run build && npm run verify:bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "lighthouse": "13.4.1",
    "sass": "1.104.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
