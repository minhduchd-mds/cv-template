{
  "name": "cv-template-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "data:sync": "node scripts/sync-sample-data.mjs",
    "data:check": "node scripts/sync-sample-data.mjs --check",
    "predev": "npm run data:sync",
    "dev": "vite",
    "serve": "vite",
    "security:lint": "node scripts/security-lint.mjs",
    "prebuild": "npm run data:sync && npm run static:check",
    "build": "vite build && node scripts/build-interview-fallback.mjs",
    "verify:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=desktop-chromium --project=tablet-chromium --project=mobile-chromium",
    "lighthouse:assert": "node scripts/assert-lighthouse.mjs",
    "verify": "npm run layout:check && npm run security:lint && npm run build && npm run verify:bundle",
    "preview": "vite preview",
    "test:perf": "playwright test tests/e2e/studio-perf.spec.js --project=desktop-chromium --project=tablet-chromium --project=mobile-chromium",
    "test:templates": "playwright test tests/e2e/template-layout-audit.spec.js --project=desktop-chromium --project=tablet-chromium --project=mobile-chromium",
    "layout:check": "node scripts/check-template-layout-contracts.mjs",
    "test:pdf-fidelity": "playwright test tests/e2e/pdf-fidelity.spec.js --project=desktop-chromium",
    "static:check": "node scripts/check-static-studio.mjs"
  },
  "dependencies": {
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "lighthouse": "13.4.1",
    "sass": "1.104.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
